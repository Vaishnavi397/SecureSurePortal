# Copy this file to ".env" (same folder) and fill in the values. NEVER commit .env.

PORT=5000
NODE_ENV=development

# --- MongoDB (local or Atlas) ---
MONGODB_URI=mongodb://127.0.0.1:27017/securesure

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# --- CORS (frontend dev server) ---
CORS_ORIGIN=http://localhost:5173

# --- Amazon S3 (document upload) ---
AWS_REGION=ap-south-1
S3_BUCKET=
# Credentials come from the standard AWS chain. Locally either set these two
# or run "aws configure". On ECS the task IAM role is used automatically.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional (only for MinIO/LocalStack): S3_ENDPOINT=http://localhost:9000

# --- GenAI (LLM) ---
# LLM_PROVIDER = anthropic | openai | mock
# If left empty: uses anthropic if ANTHROPIC_API_KEY is set, else openai if
# OPENAI_API_KEY is set, else "mock" (offline demo mode, NOT a real LLM).
LLM_PROVIDER=
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_TIMEOUT_MS=30000

# --- RAG embeddings: local (default, no key needed) | openai ---
EMBEDDINGS_PROVIDER=local

# Lets tests add ?simulateFailure=rag|llm|s3 (always allowed outside production)
ALLOW_FAILURE_SIMULATION=false
